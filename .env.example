# Authentication & Session
SESSION_SECRET="super-secret-session-key-minimum-32-chars-long!"
ADMIN_USER="admin"
ADMIN_PASSWORD="password123"

# Server-Only Secret (Never exposed to the client)
SERVER_API_KEY="srv_sec_99482710482_demo_key"

# External Hosted API & Token
# NASA Open Data API provides an official free public working key: "DEMO_KEY"
EXTERNAL_API_NAME="NASA Open Astronomy API"
